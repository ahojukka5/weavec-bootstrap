(program
  (name "return-void")
  (version "0.1")
  (entry main)
  (fn noop
        (params)
        (returns void)
        (do
          (return_void)
        )
      )
      (fn main
        (params)
        (returns i32)
        (do
          (call_void noop)
          (return
            (const_i32 42)
          )
        )
      )
)
