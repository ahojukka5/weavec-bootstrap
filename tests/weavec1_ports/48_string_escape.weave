(program
  (name "string_escape")
  (version "0.1")
  (entry main
    (params)
          (returns i32)
          (do
            (print
              (const_string "hello\nworld")
            )
            (print
              (const_string "quote: \"weave\"")
            )
            (print
              (const_string "backslash: \\")
            )
            (return
              (const_i32 42)
            )
          )
))
