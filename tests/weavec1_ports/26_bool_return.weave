(program
  (name "bool_return")
  (version "0.1")
  (entry main)
  (fn same
    (params
      (x bool))
    (returns bool)
    (do
      (return
        (param_get x))))
  (fn main
    (params)
    (returns i32)
    (do
      (if
        (condition
          (call_bool same
            (const_bool true)))
        (then
          (do
            (return
              (const_i32 42))))
        (else
          (do
            (return
              (const_i32 0))))))))
