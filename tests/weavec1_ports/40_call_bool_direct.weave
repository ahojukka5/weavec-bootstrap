(program
  (name "call_bool_direct")
  (version "0.1")
  (entry main
    (params)
          (returns i32)
          (do
            (if
              (condition
                (call_bool is_answer
                  (const_i32 42)
                )
              )
              (then
                (do
                  (return
                    (const_i32 42)
                  )
                )
              )
              (else
                (do
                  (return
                    (const_i32 0)
                  )
                )
              )
            )
          )
))
