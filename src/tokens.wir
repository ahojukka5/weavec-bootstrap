; Token types for the Weave surface language

(core-module
  (core-version 1)
  (decls
    ; Token type constants
    (fn TOKEN_EOF (params) (returns i32) (do (return (const_i32 0))))
    (fn TOKEN_FN (params) (returns i32) (do (return (const_i32 1))))
    (fn TOKEN_RETURN (params) (returns i32) (do (return (const_i32 2))))
    (fn TOKEN_IDENT (params) (returns i32) (do (return (const_i32 3))))
    (fn TOKEN_NUMBER (params) (returns i32) (do (return (const_i32 4))))
    (fn TOKEN_LPAREN (params) (returns i32) (do (return (const_i32 5))))
    (fn TOKEN_RPAREN (params) (returns i32) (do (return (const_i32 6))))
    (fn TOKEN_LBRACE (params) (returns i32) (do (return (const_i32 7))))
    (fn TOKEN_RBRACE (params) (returns i32) (do (return (const_i32 8))))
    (fn TOKEN_ARROW (params) (returns i32) (do (return (const_i32 9))))
    (fn TOKEN_SEMI (params) (returns i32) (do (return (const_i32 10))))
    (fn TOKEN_I32 (params) (returns i32) (do (return (const_i32 11))))
  ) ;; decls
) ;; core-module
