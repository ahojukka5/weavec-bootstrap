; main.wir
;
; CLI entry point for weavec-bootstrap.
;
; Usage: weavec-bootstrap <input.weave> <output.wir>

(core-module
  (core-version 1)
  (decls

    ; External driver function
    (extern compile_file (params (input_path ptr) (output_path ptr)) (returns i32))

    ; External I/O
    (extern write (params (fd i32) (buf ptr) (count i64)) (returns i64))

    ; =============================================================================
    ; Error messages
    ; =============================================================================

    (fn print_usage
      (params)
      (returns void)
      (do
        (let msg ptr (const_string_ptr "Usage: weavec-bootstrap <input.weave> <output.wir>\n"))
        (call_i64 write (const_i32 2) (local_get msg) (const_i64 51))
        (return_void)))

    (fn print_error
      (params (error_code i32))
      (returns void)
      (do
        (let msg ptr (const_string_ptr "weavec-bootstrap: compilation failed\n"))
        (call_i64 write (const_i32 2) (local_get msg) (const_i64 37))
        (return_void)))

    ; =============================================================================
    ; Main entry point
    ; =============================================================================

    (fn main
      (params (argc i32) (argv ptr))
      (returns i32)
      (do
        ; Check argument count
        (if
          (condition (ne_i32 (param_get argc) (const_i32 3)))
          (then (do
            (call_void print_usage)
            (return (const_i32 1))))
          (else (do)))

        ; Get input and output paths from argv
        ; argv[0] = program name
        ; argv[1] = input path
        ; argv[2] = output path
        (let input_path ptr (load_ptr (ptr_add (param_get argv) (const_i64 8))))
        (let output_path ptr (load_ptr (ptr_add (param_get argv) (const_i64 16))))

        ; Compile
        (let result i32 (call_i32 compile_file (local_get input_path) (local_get output_path)))

        (if
          (condition (ne_i32 (local_get result) (const_i32 0)))
          (then (do
            (call_void print_error (local_get result))
            (return (local_get result))))
          (else (do)))

        (return (const_i32 0))))

  )
)
