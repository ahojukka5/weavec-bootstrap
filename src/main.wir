; WeaveFront - Surface language compiler
; Compiles .weave files to .wir (WIR intermediate representation)

(core-module
  (core-version 1)
  (decls
    ; External C functions
    (extern puts (params (msg ptr)) (returns i32))

    ; Compile a .weave file to .wir
    ; For now, this is a minimal implementation that outputs hardcoded WIR
    ; for our test case: fn main() -> i32 { return 42; }
    ; Outputs to stdout - use shell redirection for output file
    (fn compile_file
      (params)
      (returns i32)
      (do
        ; Emit WIR module to stdout
        (call_i32 puts (const_string_ptr "(core-module"))
        (call_i32 puts (const_string_ptr "  (core-version 1)"))
        (call_i32 puts (const_string_ptr "  (decls"))
        (call_i32 puts (const_string_ptr "    (fn main"))
        (call_i32 puts (const_string_ptr "      (params)"))
        (call_i32 puts (const_string_ptr "      (returns i32)"))
        (call_i32 puts (const_string_ptr "      (do"))
        (call_i32 puts (const_string_ptr "        (return (const_i32 42))"))
        (call_i32 puts (const_string_ptr "      ) ;; do"))
        (call_i32 puts (const_string_ptr "    ) ;; fn"))
        (call_i32 puts (const_string_ptr "  ) ;; decls"))
        (call_i32 puts (const_string_ptr ") ;; core-module"))

        (return (const_i32 0))
      ) ;; do
    ) ;; fn

    ; Main entry point
    (fn weave_main
      (params (argc i32) (argv ptr))
      (returns i32)
      (do
        ; Just compile - ignore args for now since we output to stdout
        (return (call_i32 compile_file))
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
