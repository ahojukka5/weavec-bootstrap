; SPDX-License-Identifier: Apache-2.0
; surface_lower.wir
;
; Transforms Surface Weave to WIR.
;
; Transformation:
;   (program (name "x") (entry main ...) (fn helper ...)) → (core-module (core-version 1) (decls (fn main ...) (fn helper ...)))
;
; Strategy:
;   - Build new tree with WIR structure
;   - Transform (entry ...) to (fn ...)
;   - Copy all (fn ...) nodes into (decls ...)
;   - Copy body recursively (already WIR-like)
;   - Ignore metadata nodes (name, version)

(core-module
  (core-version 1)
  (decls

    ; External memory functions
    (extern malloc (params (size i64)) (returns ptr))
    (extern free (params (p ptr)) (returns void))
    (extern memcpy (params (dest ptr) (src ptr) (n i64)) (returns ptr))

    ; External string length
    (extern strlen (params (s ptr)) (returns i64))

    ; External tree functions
    (extern tree_new (params) (returns ptr))
    (extern tree_append_node
      (params (tree ptr) (kind i32) (text_start i64) (text_len i64)
              (first_child i64) (next_sibling i64) (value i64))
      (returns i64))
    (extern node_kind (params (tree ptr) (index i64)) (returns i32))
    (extern node_text_start (params (tree ptr) (index i64)) (returns i64))
    (extern node_text_len (params (tree ptr) (index i64)) (returns i64))
    (extern node_first_child (params (tree ptr) (index i64)) (returns i64))
    (extern node_next_sibling (params (tree ptr) (index i64)) (returns i64))
    (extern node_value (params (tree ptr) (index i64)) (returns i64))
    (extern node_set_first_child (params (tree ptr) (index i64) (child_index i64)) (returns void))
    (extern node_set_next_sibling (params (tree ptr) (index i64) (sibling_index i64)) (returns void))

    ; External node kind constants
    (extern node_list (params) (returns i32))
    (extern node_ident (params) (returns i32))
    (extern node_string (params) (returns i32))
    (extern node_int (params) (returns i32))

    ; =============================================================================
    ; String comparison
    ; =============================================================================

    ; Compare text at node with expected string
    (extern node_text_equals
      (params (tree ptr) (source ptr) (node_index i64) (expected ptr) (expected_len i64))
      (returns i32))

    ; External struct and const lowering (defined in surface_struct.wir)
    (extern lower_struct_decls
      (params (src_tree ptr) (source ptr) (dest_tree ptr) (last_decl_ptr ptr))
      (returns void))
    (extern lower_const_decls
      (params (src_tree ptr) (source ptr) (dest_tree ptr) (keywords_len i64) (last_decl_ptr ptr))
      (returns void))

    ; =============================================================================
    ; WIR Keywords for synthetic source
    ; =============================================================================

    ; Build unified source: [250-byte keyword prefix][struct names][original source]
    ;
    ; Keyword prefix layout (offsets used by gen_getter/gen_setter in surface_struct.wir):
    ;   0:   core-module   11:  core-version  23:  fn      25:  decls
    ;   30:  extern        36:  params        42:  returns 49:  do
    ;   51:  let           54:  local_get     63:  param_get 72: return
    ;   78:  call_i32      86:  call_i64      94:  set     97:  call_ptr
    ;   105: call_void     114: malloc        120: const_i64 129: const_null
    ;   139: eq_ptr        145: ptr_add       152: load_i64  160: load_i32
    ;   168: load_ptr      176: store_i64     185: store_i32 194: store_ptr
    ;   203: ptr           206: i64           209: i32     212: void
    ;   216: const_i32     225: v             226: call_void 235: self
    ;   239: return_void
    ;
    ; Parameters:
    ;   original_source  - original .weave source bytes
    ;   original_len     - length of original source
    ;   names_buf        - buffer of generated struct accessor names (may be null)
    ;   names_len        - length of names_buf (0 when no structs)
    ;   out_keywords_len - written with (250 + names_len), the offset of original source
    ;
    ; Returns ptr to unified source, or null on allocation failure.
    (fn build_unified_source
      (params (original_source ptr) (original_len i64) (names_buf ptr) (names_len i64) (out_keywords_len ptr))
      (returns ptr)
      (do
        ; keywords_len = 250 (base prefix) + names_len
        (let keywords_len i64 (add_i64 (const_i64 250) (param_get names_len)))
        (store_i64 (param_get out_keywords_len) (local_get keywords_len))

        ; Allocate unified buffer
        (let total_len i64 (add_i64 (local_get keywords_len) (param_get original_len)))
        (let unified ptr (call_ptr malloc (local_get total_len)))
        (if
          (condition (eq_ptr (local_get unified) (const_null)))
          (then (do (return (const_null))))
          (else (do)))

        ; Write 250-byte keyword prefix using memcpy
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 0))   (const_string_ptr "core-module")  (const_i64 11))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 11))  (const_string_ptr "core-version") (const_i64 12))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 23))  (const_string_ptr "fn")           (const_i64 2))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 25))  (const_string_ptr "decls")        (const_i64 5))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 30))  (const_string_ptr "extern")       (const_i64 6))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 36))  (const_string_ptr "params")       (const_i64 6))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 42))  (const_string_ptr "returns")      (const_i64 7))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 49))  (const_string_ptr "do")           (const_i64 2))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 51))  (const_string_ptr "let")          (const_i64 3))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 54))  (const_string_ptr "local_get")    (const_i64 9))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 63))  (const_string_ptr "param_get")    (const_i64 9))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 72))  (const_string_ptr "return")       (const_i64 6))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 78))  (const_string_ptr "call_i32")     (const_i64 8))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 86))  (const_string_ptr "call_i64")     (const_i64 8))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 94))  (const_string_ptr "set")          (const_i64 3))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 97))  (const_string_ptr "call_ptr")     (const_i64 8))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 105)) (const_string_ptr "call_void")    (const_i64 9))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 114)) (const_string_ptr "malloc")       (const_i64 6))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 120)) (const_string_ptr "const_i64")    (const_i64 9))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 129)) (const_string_ptr "const_null")   (const_i64 10))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 139)) (const_string_ptr "eq_ptr")       (const_i64 6))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 145)) (const_string_ptr "ptr_add")      (const_i64 7))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 152)) (const_string_ptr "load_i64")     (const_i64 8))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 160)) (const_string_ptr "load_i32")     (const_i64 8))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 168)) (const_string_ptr "load_ptr")     (const_i64 8))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 176)) (const_string_ptr "store_i64")    (const_i64 9))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 185)) (const_string_ptr "store_i32")    (const_i64 9))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 194)) (const_string_ptr "store_ptr")    (const_i64 9))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 203)) (const_string_ptr "ptr")          (const_i64 3))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 206)) (const_string_ptr "i64")          (const_i64 3))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 209)) (const_string_ptr "i32")          (const_i64 3))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 212)) (const_string_ptr "void")         (const_i64 4))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 216)) (const_string_ptr "const_i32")    (const_i64 9))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 225)) (const_string_ptr "v")            (const_i64 1))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 226)) (const_string_ptr "call_void")    (const_i64 9))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 235)) (const_string_ptr "self")         (const_i64 4))
        (call_ptr memcpy (ptr_add (local_get unified) (const_i64 239)) (const_string_ptr "return_void")  (const_i64 11))

        ; Copy struct names after keyword prefix (at offset 250)
        (if
          (condition (gt_i64 (param_get names_len) (const_i64 0)))
          (then (do
            (call_ptr memcpy
              (ptr_add (local_get unified) (const_i64 250))
              (param_get names_buf)
              (param_get names_len))))
          (else (do)))

        ; Copy original source after keywords + names
        (call_ptr memcpy
          (ptr_add (local_get unified) (local_get keywords_len))
          (param_get original_source)
          (param_get original_len))

        (return (local_get unified))))

    ; =============================================================================
    ; Tree copying
    ; =============================================================================

    ; Copy a node and its children from source tree to dest tree
    ; Adjust text_start by source_offset
    ; Returns the new node index in dest tree
    (fn copy_node_with_offset
      (params (src_tree ptr) (dest_tree ptr) (node_index i64) (source_offset i64))
      (returns i64)
      (do
        (let kind i32 (call_i32 node_kind (param_get src_tree) (param_get node_index)))
        (let text_start i64 (call_i64 node_text_start (param_get src_tree) (param_get node_index)))
        (let text_len i64 (call_i64 node_text_len (param_get src_tree) (param_get node_index)))
        (let value i64 (call_i64 node_value (param_get src_tree) (param_get node_index)))

        ; Adjust text_start by source_offset
        (let adjusted_start i64 (add_i64 (local_get text_start) (param_get source_offset)))

        ; Create new node in dest tree
        (let new_node i64
          (call_i64 tree_append_node
            (param_get dest_tree)
            (local_get kind)
            (local_get adjusted_start)
            (local_get text_len)
            (const_i64 -1)
            (const_i64 -1)
            (local_get value)))

        ; If this is a list, copy children
        (if
          (condition (eq_i32 (local_get kind) (call_i32 node_list)))
          (then (do
            (let first_child i64 (call_i64 node_first_child (param_get src_tree) (param_get node_index)))
            (if
              (condition (ne_i64 (local_get first_child) (const_i64 -1)))
              (then (do
                ; Copy all children
                (let child i64 (local_get first_child))
                (let new_first i64 (const_i64 -1))
                (let new_prev i64 (const_i64 -1))

                (while
                  (condition (ne_i64 (local_get child) (const_i64 -1)))
                  (do
                    (let new_child i64 (call_i64 copy_node_with_offset
                      (param_get src_tree)
                      (param_get dest_tree)
                      (local_get child)
                      (param_get source_offset)))

                    (if
                      (condition (eq_i64 (local_get new_first) (const_i64 -1)))
                      (then (do (set new_first (local_get new_child))))
                      (else (do
                        (call_void node_set_next_sibling
                          (param_get dest_tree)
                          (local_get new_prev)
                          (local_get new_child)))))

                    (set new_prev (local_get new_child))
                    (set child (call_i64 node_next_sibling (param_get src_tree) (local_get child)))))

                ; Update first_child of new node
                (call_void node_set_first_child
                  (param_get dest_tree)
                  (local_get new_node)
                  (local_get new_first))))
              (else (do)))))
          (else (do)))

        (return (local_get new_node))))

    ; Original copy_node for backward compatibility
    (fn copy_node
      (params (src_tree ptr) (dest_tree ptr) (node_index i64))
      (returns i64)
      (do
        (let kind i32 (call_i32 node_kind (param_get src_tree) (param_get node_index)))
        (let text_start i64 (call_i64 node_text_start (param_get src_tree) (param_get node_index)))
        (let text_len i64 (call_i64 node_text_len (param_get src_tree) (param_get node_index)))
        (let value i64 (call_i64 node_value (param_get src_tree) (param_get node_index)))

        ; Create new node in dest tree (will update children/siblings later)
        (let new_node i64
          (call_i64 tree_append_node
            (param_get dest_tree)
            (local_get kind)
            (local_get text_start)
            (local_get text_len)
            (const_i64 -1)
            (const_i64 -1)
            (local_get value)))

        ; If this is a list, copy children
        (if
          (condition (eq_i32 (local_get kind) (call_i32 node_list)))
          (then (do
            (let first_child i64 (call_i64 node_first_child (param_get src_tree) (param_get node_index)))
            (if
              (condition (ne_i64 (local_get first_child) (const_i64 -1)))
              (then (do
                ; Copy all children
                (let child i64 (local_get first_child))
                (let new_first i64 (const_i64 -1))
                (let new_prev i64 (const_i64 -1))

                (while
                  (condition (ne_i64 (local_get child) (const_i64 -1)))
                  (do
                    (let new_child i64 (call_i64 copy_node
                      (param_get src_tree)
                      (param_get dest_tree)
                      (local_get child)))

                    (if
                      (condition (eq_i64 (local_get new_first) (const_i64 -1)))
                      (then (do (set new_first (local_get new_child))))
                      (else (do
                        (call_void node_set_next_sibling
                          (param_get dest_tree)
                          (local_get new_prev)
                          (local_get new_child)))))

                    (set new_prev (local_get new_child))
                    (set child (call_i64 node_next_sibling (param_get src_tree) (local_get child)))))

                ; Update first_child of new node
                (call_void node_set_first_child
                  (param_get dest_tree)
                  (local_get new_node)
                  (local_get new_first))))
              (else (do)))))
          (else (do)))

        (return (local_get new_node))))

    ; =============================================================================
    ; Struct name scanning helpers
    ; =============================================================================

    ; Return total bytes needed for all generated struct accessor names.
    ; For each (struct NAME (field F T) ...) with N fields, we generate
    ; N getter names (NAME_get_F) and N setter names (NAME_set_F), each of
    ; length len(NAME) + 5 + len(F).
    (fn scan_struct_total_len
      (params (src_tree ptr) (source ptr))
      (returns i64)
      (do
        (let total i64 (const_i64 0))
        (let prog_first i64 (call_i64 node_first_child (param_get src_tree) (const_i64 0)))
        (let scan i64 (call_i64 node_next_sibling (param_get src_tree) (local_get prog_first)))
        (while
          (condition (ne_i64 (local_get scan) (const_i64 -1)))
          (do
            (if
              (condition (eq_i32 (call_i32 node_kind (param_get src_tree) (local_get scan)) (call_i32 node_list)))
              (then (do
                (let cf i64 (call_i64 node_first_child (param_get src_tree) (local_get scan)))
                (if
                  (condition (ne_i64 (local_get cf) (const_i64 -1)))
                  (then (do
                    (if
                      (condition (ne_i32
                        (call_i32 node_text_equals
                          (param_get src_tree) (param_get source) (local_get cf)
                          (const_string_ptr "struct") (const_i64 6))
                        (const_i32 0)))
                      (then (do
                        (let sn    i64 (call_i64 node_next_sibling (param_get src_tree) (local_get cf)))
                        (let slen  i64 (call_i64 node_text_len     (param_get src_tree) (local_get sn)))
                        (let fnode i64 (call_i64 node_next_sibling (param_get src_tree) (local_get sn)))
                        (while
                          (condition (ne_i64 (local_get fnode) (const_i64 -1)))
                          (do
                            (if
                              (condition (eq_i32 (call_i32 node_kind (param_get src_tree) (local_get fnode)) (call_i32 node_list)))
                              (then (do
                                (let fkw i64 (call_i64 node_first_child (param_get src_tree) (local_get fnode)))
                                (if
                                  (condition (ne_i32
                                    (call_i32 node_text_equals
                                      (param_get src_tree) (param_get source) (local_get fkw)
                                      (const_string_ptr "field") (const_i64 5))
                                    (const_i32 0)))
                                  (then (do
                                    (let fnm    i64 (call_i64 node_next_sibling (param_get src_tree) (local_get fkw)))
                                    (let fnmlen i64 (call_i64 node_text_len     (param_get src_tree) (local_get fnm)))
                                    (let onelen i64 (add_i64 (local_get slen) (add_i64 (const_i64 5) (local_get fnmlen))))
                                    (set total (add_i64 (local_get total) (add_i64 (local_get onelen) (local_get onelen))))))
                                  (else (do)))))
                              (else (do)))
                            (set fnode (call_i64 node_next_sibling (param_get src_tree) (local_get fnode)))))))
                      (else (do)))))
                  (else (do)))))
              (else (do)))
            (set scan (call_i64 node_next_sibling (param_get src_tree) (local_get scan)))))
        (return (local_get total))))

    ; Write all generated struct accessor names into buf.
    ; Returns total bytes written (equals scan_struct_total_len result).
    ; Layout: for each struct in source order, for each field in field order:
    ;   NAME_get_FNAME   (len(NAME) + 5 + len(FNAME) bytes)
    ;   NAME_set_FNAME   (same length)
    (fn build_struct_names
      (params (src_tree ptr) (source ptr) (buf ptr))
      (returns i64)
      (do
        (let pos i64 (const_i64 0))
        (let prog_first i64 (call_i64 node_first_child (param_get src_tree) (const_i64 0)))
        (let scan i64 (call_i64 node_next_sibling (param_get src_tree) (local_get prog_first)))
        (while
          (condition (ne_i64 (local_get scan) (const_i64 -1)))
          (do
            (if
              (condition (eq_i32 (call_i32 node_kind (param_get src_tree) (local_get scan)) (call_i32 node_list)))
              (then (do
                (let cf i64 (call_i64 node_first_child (param_get src_tree) (local_get scan)))
                (if
                  (condition (ne_i64 (local_get cf) (const_i64 -1)))
                  (then (do
                    (if
                      (condition (ne_i32
                        (call_i32 node_text_equals
                          (param_get src_tree) (param_get source) (local_get cf)
                          (const_string_ptr "struct") (const_i64 6))
                        (const_i32 0)))
                      (then (do
                        (let sn    i64 (call_i64 node_next_sibling (param_get src_tree) (local_get cf)))
                        (let snts  i64 (call_i64 node_text_start   (param_get src_tree) (local_get sn)))
                        (let slen  i64 (call_i64 node_text_len     (param_get src_tree) (local_get sn)))
                        (let fnode i64 (call_i64 node_next_sibling (param_get src_tree) (local_get sn)))
                        (while
                          (condition (ne_i64 (local_get fnode) (const_i64 -1)))
                          (do
                            (if
                              (condition (eq_i32 (call_i32 node_kind (param_get src_tree) (local_get fnode)) (call_i32 node_list)))
                              (then (do
                                (let fkw i64 (call_i64 node_first_child (param_get src_tree) (local_get fnode)))
                                (if
                                  (condition (ne_i32
                                    (call_i32 node_text_equals
                                      (param_get src_tree) (param_get source) (local_get fkw)
                                      (const_string_ptr "field") (const_i64 5))
                                    (const_i32 0)))
                                  (then (do
                                    (let fnm   i64 (call_i64 node_next_sibling (param_get src_tree) (local_get fkw)))
                                    (let fnmts i64 (call_i64 node_text_start   (param_get src_tree) (local_get fnm)))
                                    (let fnmlen i64 (call_i64 node_text_len    (param_get src_tree) (local_get fnm)))
                                    ; getter: NAME_get_FNAME
                                    (call_ptr memcpy (ptr_add (param_get buf) (local_get pos)) (ptr_add (param_get source) (local_get snts))  (local_get slen))
                                    (set pos (add_i64 (local_get pos) (local_get slen)))
                                    (call_ptr memcpy (ptr_add (param_get buf) (local_get pos)) (const_string_ptr "_get_") (const_i64 5))
                                    (set pos (add_i64 (local_get pos) (const_i64 5)))
                                    (call_ptr memcpy (ptr_add (param_get buf) (local_get pos)) (ptr_add (param_get source) (local_get fnmts)) (local_get fnmlen))
                                    (set pos (add_i64 (local_get pos) (local_get fnmlen)))
                                    ; setter: NAME_set_FNAME
                                    (call_ptr memcpy (ptr_add (param_get buf) (local_get pos)) (ptr_add (param_get source) (local_get snts))  (local_get slen))
                                    (set pos (add_i64 (local_get pos) (local_get slen)))
                                    (call_ptr memcpy (ptr_add (param_get buf) (local_get pos)) (const_string_ptr "_set_") (const_i64 5))
                                    (set pos (add_i64 (local_get pos) (const_i64 5)))
                                    (call_ptr memcpy (ptr_add (param_get buf) (local_get pos)) (ptr_add (param_get source) (local_get fnmts)) (local_get fnmlen))
                                    (set pos (add_i64 (local_get pos) (local_get fnmlen)))))
                                  (else (do)))))
                              (else (do)))
                            (set fnode (call_i64 node_next_sibling (param_get src_tree) (local_get fnode)))))))
                      (else (do)))))
                  (else (do)))))
              (else (do)))
            (set scan (call_i64 node_next_sibling (param_get src_tree) (local_get scan)))))
        (return (local_get pos))))

    ; =============================================================================
    ; Lowering transformation
    ; =============================================================================

    ; Lower Surface program to WIR
    ; Returns new tree or null on error
    ; Writes unified source ptr to out_unified_source
    (fn lower
      (params (src_tree ptr) (source ptr) (source_len i64) (out_unified_source ptr))
      (returns ptr)
      (do
        ; Scan for struct declarations and build names buffer
        (let names_len i64 (call_i64 scan_struct_total_len (param_get src_tree) (param_get source)))
        (let names_buf ptr (const_null))
        (if
          (condition (gt_i64 (local_get names_len) (const_i64 0)))
          (then (do
            (set names_buf (call_ptr malloc (local_get names_len)))
            (if
              (condition (eq_ptr (local_get names_buf) (const_null)))
              (then (do (return (const_null))))
              (else (do)))
            (call_i64 build_struct_names (param_get src_tree) (param_get source) (local_get names_buf))))
          (else (do)))

        ; Build unified source: [250-byte keyword prefix][struct names][original source]
        (let keywords_len_ptr ptr (call_ptr malloc (const_i64 8)))
        (let unified_source ptr (call_ptr build_unified_source
          (param_get source)
          (param_get source_len)
          (local_get names_buf)
          (local_get names_len)
          (local_get keywords_len_ptr)))
        (let keywords_len i64 (load_i64 (local_get keywords_len_ptr)))
        (call_void free (local_get keywords_len_ptr))

        ; Free names_buf (content already memcpy'd into unified_source)
        (if
          (condition (ne_ptr (local_get names_buf) (const_null)))
          (then (do (call_void free (local_get names_buf))))
          (else (do)))

        (if
          (condition (eq_ptr (local_get unified_source) (const_null)))
          (then (do (return (const_null))))
          (else (do)))

        ; Store unified source in output parameter
        (store_ptr (param_get out_unified_source) (local_get unified_source))

        ; Create new tree for WIR
        (let dest_tree ptr (call_ptr tree_new))
        (if
          (condition (eq_ptr (local_get dest_tree) (const_null)))
          (then (do (return (const_null))))
          (else (do)))

        ; Find the (entry ...) node and all (fn ...) nodes
        (let program_root i64 (const_i64 0))
        (let program_first i64 (call_i64 node_first_child (param_get src_tree) (local_get program_root)))

        ; Skip "program" keyword
        (let program_child i64 (call_i64 node_next_sibling (param_get src_tree) (local_get program_first)))

        (let entry_node i64 (const_i64 -1))
        (let fn_count i32 (const_i32 0))

        ; First pass: find entry node
        (let temp_child i64 (local_get program_child))
        (while
          (condition (ne_i64 (local_get temp_child) (const_i64 -1)))
          (do
            (let child_kind i32 (call_i32 node_kind (param_get src_tree) (local_get temp_child)))
            (if
              (condition (eq_i32 (local_get child_kind) (call_i32 node_list)))
              (then (do
                (let child_first i64 (call_i64 node_first_child (param_get src_tree) (local_get temp_child)))
                (if
                  (condition (ne_i64 (local_get child_first) (const_i64 -1)))
                  (then (do
                    (if
                      (condition (ne_i32
                        (call_i32 node_text_equals
                          (param_get src_tree)
                          (param_get source)
                          (local_get child_first)
                          (const_string_ptr "entry")
                          (const_i64 5))
                        (const_i32 0)))
                      (then (do
                        (set entry_node (local_get temp_child))
                        (set temp_child (const_i64 -1))))
                      (else (do
                        (set temp_child (call_i64 node_next_sibling (param_get src_tree) (local_get temp_child))))))))
                  (else (do
                    (set temp_child (call_i64 node_next_sibling (param_get src_tree) (local_get temp_child))))))))
              (else (do
                (set temp_child (call_i64 node_next_sibling (param_get src_tree) (local_get temp_child))))))))

        ; Check we found entry
        (if
          (condition (eq_i64 (local_get entry_node) (const_i64 -1)))
          (then (do (return (const_null))))
          (else (do)))

        ; Build WIR structure: (core-module ...)
        (let core_module_node i64
          (call_i64 tree_append_node
            (local_get dest_tree)
            (call_i32 node_list)
            (const_i64 0)
            (const_i64 1)
            (const_i64 -1)
            (const_i64 -1)
            (const_i64 0)))

        ; Add "core-module" identifier
        (let core_module_ident i64
          (call_i64 tree_append_node
            (local_get dest_tree)
            (call_i32 node_ident)
            (const_i64 0)
            (const_i64 11)
            (const_i64 -1)
            (const_i64 -1)
            (const_i64 0)))

        ; Add (core-version 1)
        (let core_version_node i64
          (call_i64 tree_append_node
            (local_get dest_tree)
            (call_i32 node_list)
            (const_i64 0)
            (const_i64 1)
            (const_i64 -1)
            (const_i64 -1)
            (const_i64 0)))

        (let core_version_ident i64
          (call_i64 tree_append_node
            (local_get dest_tree)
            (call_i32 node_ident)
            (const_i64 11)
            (const_i64 12)
            (const_i64 -1)
            (const_i64 -1)
            (const_i64 0)))

        (let core_version_num i64
          (call_i64 tree_append_node
            (local_get dest_tree)
            (call_i32 node_int)
            (const_i64 0)
            (const_i64 1)
            (const_i64 -1)
            (const_i64 -1)
            (const_i64 1)))

        ; Link core-version children
        (call_void node_set_first_child
          (local_get dest_tree)
          (local_get core_version_node)
          (local_get core_version_ident))
        (call_void node_set_next_sibling
          (local_get dest_tree)
          (local_get core_version_ident)
          (local_get core_version_num))

        ; Add (decls ...)
        (let decls_node i64
          (call_i64 tree_append_node
            (local_get dest_tree)
            (call_i32 node_list)
            (const_i64 0)
            (const_i64 1)
            (const_i64 -1)
            (const_i64 -1)
            (const_i64 0)))

        (let decls_ident i64
          (call_i64 tree_append_node
            (local_get dest_tree)
            (call_i32 node_ident)
            (const_i64 25)
            (const_i64 5)
            (const_i64 -1)
            (const_i64 -1)
            (const_i64 0)))

        ; Transform (entry ...) to (fn ...) and copy additional (fn ...) nodes
        (let decls_children_prev i64 (local_get decls_ident))
        (let first_decl i64 (const_i64 -1))

        ; Pass 0: copy (extern ...) nodes before fn nodes (LLVM IR convention: declare before define)
        (let extern_scan i64 (local_get program_child))
        (while
          (condition (ne_i64 (local_get extern_scan) (const_i64 -1)))
          (do
            (let ext_kind i32 (call_i32 node_kind (param_get src_tree) (local_get extern_scan)))
            (if
              (condition (eq_i32 (local_get ext_kind) (call_i32 node_list)))
              (then (do
                (let ext_first i64 (call_i64 node_first_child (param_get src_tree) (local_get extern_scan)))
                (if
                  (condition (ne_i64 (local_get ext_first) (const_i64 -1)))
                  (then (do
                    (if
                      (condition (ne_i32
                        (call_i32 node_text_equals
                          (param_get src_tree)
                          (param_get source)
                          (local_get ext_first)
                          (const_string_ptr "extern")
                          (const_i64 6))
                        (const_i32 0)))
                      (then (do
                        (let copied_ext i64 (call_i64 copy_node_with_offset
                          (param_get src_tree)
                          (local_get dest_tree)
                          (local_get extern_scan)
                          (local_get keywords_len)))
                        (if
                          (condition (eq_i64 (local_get first_decl) (const_i64 -1)))
                          (then (do (set first_decl (local_get copied_ext))))
                          (else (do)))
                        (call_void node_set_next_sibling
                          (local_get dest_tree)
                          (local_get decls_children_prev)
                          (local_get copied_ext))
                        (set decls_children_prev (local_get copied_ext))))
                      (else (do)))))
                  (else (do)))))
              (else (do)))
            (set extern_scan (call_i64 node_next_sibling (param_get src_tree) (local_get extern_scan)))))

        ; Inspect entry: first child = "entry" keyword, second = name
        (let entry_first i64 (call_i64 node_first_child (param_get src_tree) (local_get entry_node)))
        (let entry_rest i64 (call_i64 node_next_sibling (param_get src_tree) (local_get entry_first)))
        ; entry_rest is the name node; check if it has body children after it
        (let entry_body_start i64 (call_i64 node_next_sibling (param_get src_tree) (local_get entry_rest)))

        ; Only transform entry to fn when it has an inline body (old format)
        (if
          (condition (ne_i64 (local_get entry_body_start) (const_i64 -1)))
          (then (do
            (let fn_node i64
              (call_i64 tree_append_node
                (local_get dest_tree)
                (call_i32 node_list)
                (const_i64 0)
                (const_i64 1)
                (const_i64 -1)
                (const_i64 -1)
                (const_i64 0)))

            (let fn_ident i64
              (call_i64 tree_append_node
                (local_get dest_tree)
                (call_i32 node_ident)
                (const_i64 23)
                (const_i64 2)
                (const_i64 -1)
                (const_i64 -1)
                (const_i64 0)))

            ; Copy all children of entry after "entry" keyword (name, params, returns, body)
            (let fn_children_prev i64 (local_get fn_ident))

            (while
              (condition (ne_i64 (local_get entry_rest) (const_i64 -1)))
              (do
                (let copied_child i64 (call_i64 copy_node_with_offset
                  (param_get src_tree)
                  (local_get dest_tree)
                  (local_get entry_rest)
                  (local_get keywords_len)))

                (call_void node_set_next_sibling
                  (local_get dest_tree)
                  (local_get fn_children_prev)
                  (local_get copied_child))

                (set fn_children_prev (local_get copied_child))
                (set entry_rest (call_i64 node_next_sibling (param_get src_tree) (local_get entry_rest)))))

            ; Link fn_node children
            (call_void node_set_first_child
              (local_get dest_tree)
              (local_get fn_node)
              (local_get fn_ident))

            ; Link fn_node into decls after any externs already appended
            (if
              (condition (eq_i64 (local_get first_decl) (const_i64 -1)))
              (then (do (set first_decl (local_get fn_node))))
              (else (do
                (call_void node_set_next_sibling
                  (local_get dest_tree)
                  (local_get decls_children_prev)
                  (local_get fn_node)))))
            (set decls_children_prev (local_get fn_node))))
          (else (do)))

        ; Copy all (fn ...) nodes from the program declarations
        ; For name-only entry format this is the primary source of function declarations
        (set program_child (call_i64 node_next_sibling (param_get src_tree) (local_get program_first)))
        (while
          (condition (ne_i64 (local_get program_child) (const_i64 -1)))
          (do
            (let fn_child_kind i32 (call_i32 node_kind (param_get src_tree) (local_get program_child)))
            (if
              (condition (eq_i32 (local_get fn_child_kind) (call_i32 node_list)))
              (then (do
                (let fn_child_first i64 (call_i64 node_first_child (param_get src_tree) (local_get program_child)))
                (if
                  (condition (ne_i64 (local_get fn_child_first) (const_i64 -1)))
                  (then (do
                    ; Check if this is a fn node
                    (if
                      (condition (ne_i32
                        (call_i32 node_text_equals
                          (param_get src_tree)
                          (param_get source)
                          (local_get fn_child_first)
                          (const_string_ptr "fn")
                          (const_i64 2))
                        (const_i32 0)))
                      (then (do
                        ; Copy the entire fn node
                        (let copied_fn i64 (call_i64 copy_node_with_offset
                          (param_get src_tree)
                          (local_get dest_tree)
                          (local_get program_child)
                          (local_get keywords_len)))

                        ; If first_decl not set yet (name-only entry), set it now
                        (if
                          (condition (eq_i64 (local_get first_decl) (const_i64 -1)))
                          (then (do (set first_decl (local_get copied_fn))))
                          (else (do)))

                        ; Link as sibling
                        (call_void node_set_next_sibling
                          (local_get dest_tree)
                          (local_get decls_children_prev)
                          (local_get copied_fn))

                        (set decls_children_prev (local_get copied_fn))))
                      (else (do)))))
                  (else (do)))))
              (else (do)))
            (set program_child (call_i64 node_next_sibling (param_get src_tree) (local_get program_child)))))

        ; Generate struct accessor functions and named constant functions
        (let decls_prev_storage ptr (call_ptr malloc (const_i64 8)))
        (store_i64 (local_get decls_prev_storage) (local_get decls_children_prev))
        (if
          (condition (gt_i64 (local_get names_len) (const_i64 0)))
          (then (do
            (call_void lower_struct_decls
              (param_get src_tree) (param_get source) (local_get dest_tree) (local_get decls_prev_storage))))
          (else (do)))
        (call_void lower_const_decls
          (param_get src_tree) (param_get source) (local_get dest_tree) (local_get keywords_len) (local_get decls_prev_storage))
        (set decls_children_prev (load_i64 (local_get decls_prev_storage)))
        (call_void free (local_get decls_prev_storage))

        ; Link decls children
        (call_void node_set_first_child
          (local_get dest_tree)
          (local_get decls_node)
          (local_get decls_ident))
        (call_void node_set_next_sibling
          (local_get dest_tree)
          (local_get decls_ident)
          (local_get first_decl))

        ; Link core-module children
        (call_void node_set_first_child
          (local_get dest_tree)
          (local_get core_module_node)
          (local_get core_module_ident))
        (call_void node_set_next_sibling
          (local_get dest_tree)
          (local_get core_module_ident)
          (local_get core_version_node))
        (call_void node_set_next_sibling
          (local_get dest_tree)
          (local_get core_version_node)
          (local_get decls_node))

        (return (local_get dest_tree))))

  )
)